<?xml version="1.0" encoding="UTF-8"?>
<formats xmlns="http://schemas.sulu.io/media/formats"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://schemas.sulu.io/media/formats http://schemas.sulu.io/media/formats-1.1.xsd">

    <!-- See: http://docs.sulu.io/en/latest/book/image-formats.html how to define image-formats -->

    <format key="frontend-gallery-800x">
        <meta>
            <title lang="en">Gallery thumbnail</title>
            <title lang="de">Galerie-Vorschaubild</title>
        </meta>
        <scale x="800" y="800" mode="outbound"/>
        <options>
            <option name="jpeg_quality">80</option>
            <option name="webp_quality">80</option>
        </options>
    </format>

    <format key="frontend-content-960x">
        <meta>
            <title lang="en">Content image</title>
            <title lang="de">Inhaltsbild</title>
        </meta>
        <scale x="960"/>
        <options>
            <option name="jpeg_quality">80</option>
            <option name="webp_quality">80</option>
        </options>
    </format>

    <format key="frontend-slider-1600x">
        <meta>
            <title lang="en">Slider background</title>
            <title lang="de">Slider-Hintergrund</title>
        </meta>
        <scale x="1600"/>
        <options>
            <option name="jpeg_quality">80</option>
            <option name="webp_quality">80</option>
        </options>
    </format>

    <format key="frontend-stage-1920x">
        <meta>
            <title lang="en">Stage background</title>
            <title lang="de">Stage-Hintergrund</title>
        </meta>
        <scale x="1920"/>
        <options>
            <option name="jpeg_quality">80</option>
            <option name="webp_quality">80</option>
        </options>
    </format>

    <!--
    Render an image from the media_selection in a specific format the following way:

    <img src="{{ image.thumbnails['300x'] }}" alt="{{ image.title }}" title="{{ image.description|default(image.title) }}">
    -->
</formats>
