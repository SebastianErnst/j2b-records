<?xml version="1.0" ?>
<section name="contentSection"
         xmlns="http://schemas.sulu.io/template/template"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">
    <meta>
        <title lang="en">About us</title>
        <title lang="de">Über uns</title>
    </meta>
    <properties>
        <property name="contentSectionHeadline" type="text_line">
            <meta>
                <title lang="en">Title</title>
                <title lang="de">Titel</title>
            </meta>
        </property>

        <property name="contentSectionText" type="text_editor" mandatory="true">
            <meta>
                <title lang="en">Text</title>
                <title lang="de">Text</title>
            </meta>
        </property>

        <property name="contentSectionImage" type="single_media_selection" mandatory="true">
            <meta>
                <title lang="en">Image</title>
                <title lang="de">Bild</title>
            </meta>
            <params>
                <param name="types" value="image"/>
            </params>
        </property>
    </properties>
</section>