<?xml version="1.0" ?>
<section name="imageGallery"
         xmlns="http://schemas.sulu.io/template/template"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">
    <meta>
        <title lang="en">Image gallery</title>
        <title lang="de">Bildergalerie</title>
    </meta>
    <properties>
        <property name="imageGalleryHeadline" type="text_line">
            <meta>
                <title lang="en">Title</title>
                <title lang="de">Titel</title>
            </meta>
        </property>
        <block name="imageGalleryItems" default-type="imageGalleryItem" minOccurs="1">
            <params>
                <param name="add_button_text">
                    <meta>
                        <title lang="en">Add image</title>
                        <title lang="de">Bild hinzufügen</title>
                    </meta>
                </param>
            </params>
            <types>
                <type name="imageGalleryItem">
                    <properties>
                        <property name="imageGalleryItemImage" type="single_media_selection" mandatory="true">
                            <meta>
                                <title lang="en">Image</title>
                                <title lang="de">Bild</title>
                            </meta>
                            <params>
                                <param name="types" value="image"/>
                            </params>
                        </property>
                        <property name="imageGalleryItemTitle" type="text_line">
                            <meta>
                                <title lang="en">Caption</title>
                                <title lang="de">Bildunterschrift</title>
                            </meta>
                        </property>
                    </properties>
                </type>
            </types>
        </block>
    </properties>
</section>