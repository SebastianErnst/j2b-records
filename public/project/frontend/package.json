{
  "name": "J2BRecords",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "watch": "npm-run-all --parallel watch:scripts watch:styles",
    "watch:styles": "sass --watch --load-path=node_modules --load-path=src/styles src/styles:build",
    "watch:scripts": "webpack --config webpack.config-dev.js",
    "build": "npm-run-all createBuildFolder copyFontsToBuild copyImagesToBuild build:styles build:scripts",
    "build:styles": "sass --load-path=node_modules --load-path=src/styles src/styles/:build --style=compressed",
    "build:scripts": "webpack --config webpack.config.js",
    "createBuildFolder": "shx mkdir -p build",
    "copyFontsToBuild": "shx cp -r src/fonts/. build/",
    "copyImagesToBuild": "shx cp -r src/pics/. build/"
  },
  "author": "Sebastian Ernst",
  "license": "ISC",
  "dependencies": {
    "@electronic-minds/adventure-scss": "^0.0.36",
    "amplitudejs": "^5.3.2",
    "jquery": "^3.6.1",
    "klaro": "^0.7.22",
    "lazysizes": "^5.3.2",
    "lightgallery": "^2.9.0",
    "swiper": "5.4.5"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "sass": "^1.102.0",
    "shx": "^0.4.0",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.0.1"
  }
}
