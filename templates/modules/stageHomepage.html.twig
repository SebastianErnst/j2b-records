<section id="home" class="section stage-homepage lazyload" {% if content.headerImage is not null %}data-bg="{{ content.headerImage.thumbnails['frontend-stage-1920x']|default(content.headerImage.url) }}"{% endif %}>
    <div class="section-wrapper">
        <div class="content">
            <h1 class="h1">{{ content.title }}</h1>
            {% if content.subTitle is not empty %}
                <p class="claim">{{ content.subTitle }}</p>
            {% endif %}
            <a class="button big" href="#contact">{{ 'send-a-request' | trans }}</a>
        </div>
    </div>
</section>